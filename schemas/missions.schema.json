{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission",
  "type": "object",
  "required": ["id", "mission", "state"],
  "properties": {
    "id": { "type": "number", "minimum": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["inactive", "active"] }
  }
}
