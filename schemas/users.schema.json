{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "required": ["name", "password", "pseudonym", "missions", "slot_cooldowns", "wallet", "completed_count", "cooldown_count", "selection_complete", "selection_pool", "score", "gotted_history"],
  "properties": {
    "name": { "type": "string" },
    "password": { "type": "string" },
    "pseudonym": { "type": "string", "pattern": "^[A-Z][a-z]+[A-Z][a-z]+\\d{2}$" },
    "missions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["mission", "status", "last_edit", "gotted", "comments"],
            "properties": {
              "mission": { "type": "string" },
              "status": { "type": "string", "enum": ["open", "failed", "completed"] },
              "last_edit": { "type": "string" },
              "gotted": { "type": "string" },
              "comments": { "type": "string" }
            }
          }
        ]
      }
    },
    "slot_cooldowns": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": ["string", "null"] }
    },
    "wallet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mission", "status", "timestamp", "gotted", "comments"],
        "properties": {
          "mission": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "failed"] },
          "timestamp": { "type": "string" },
          "gotted": { "type": "string" },
          "comments": { "type": "string" }
        }
      }
    },
    "completed_count": { "type": "integer", "minimum": 0 },
    "cooldown_count": { "type": "integer", "minimum": 0 },
    "selection_complete": { "type": "boolean" },
    "selection_pool": { "type": "array", "items": { "type": "number" } },
    "score": { "type": "integer" },
    "gotted_history": { "type": "array", "items": { "type": "string" } }
  }
}
