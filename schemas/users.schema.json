{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "required": ["name", "password", "pseudonym", "missions", "selection_complete", "selection_pool", "score", "asks", "gotted_history"],
  "properties": {
    "name": { "type": "string", "description": "Display/login name" },
    "password": { "type": "string", "description": "Plain-text password (friendly game)" },
    "pseudonym": { "type": "string", "pattern": "^[A-Z][a-z]+[A-Z][a-z]+\\d{2}$", "description": "Generated anonymous name for leaderboard" },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mission", "status", "last_edit", "gotted", "comments"],
        "properties": {
          "mission": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "failed", "completed"] },
          "last_edit": { "type": "string" },
          "gotted": { "type": "string" },
          "comments": { "type": "string" }
        }
      }
    },
    "selection_complete": { "type": "boolean" },
    "selection_pool": { "type": "array", "items": { "type": "number" } },
    "score": { "type": "integer" },
    "asks": { "type": "integer" },
    "gotted_history": { "type": "array", "items": { "type": "string" }, "description": "Names user has gotted; resets after full cycle" }
  }
}
